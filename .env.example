# Recommended provider for the hackathon live run.
ANTHROPIC_API_KEY=
MOZAIK_MODEL=claude-sonnet-4-6

# Optional alternative providers.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Strongly recommended for Mozaik Cloud observability.
# Pair with: npx @mozaik-ai/cloud-sdk pair
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=

# Optional asynchronous learning layer. Never required for the real-time runtime.
ADAPTION_API_KEY=
ADAPTION_MAX_ROWS=1
ADAPTION_MAX_CREDITS=10

# Paid Mozaik/Anthropic run authorization: DENY by default.
# Never put the token in client-side JavaScript, URL, source control or chat.
# Set only as a sensitive Vercel env var for the controlled operator deployment.
CALLSHEET_LIVE_RUNS_ENABLED=false
CALLSHEET_RUN_OPERATOR_TOKEN=
# Must be ISO 8601; server rejects missing, expired or >1 hour future expiry.
CALLSHEET_RUN_AUTH_EXPIRES_AT=
