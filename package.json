{
  "name": "callsheet-zero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/local-server.ts",
    "demo": "tsx scripts/demo.ts",
    "env:check": "tsx scripts/check-env.ts",
    "schema:check": "tsx scripts/check-schema.ts",
    "typecheck": "tsc --noEmit",
    "adaption:export": "tsx scripts/adaption-learning.ts",
    "adaption:estimate": "tsx scripts/adaption-learning.ts --estimate",
    "adaption:run": "tsx scripts/adaption-learning.ts --run",
    "adaption:estimate:seed": "tsx scripts/adaption-learning.ts --estimate --input-jsonl=data/adaption/verified-repair-seed.jsonl",
    "adaption:run:seed": "tsx scripts/adaption-learning.ts --run --input-jsonl=data/adaption/verified-repair-seed.jsonl",
    "test:ui": "node --test tests/continuity.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.0.5",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.521",
    "@remotion/player": "^4.0.521",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.0.1",
    "remotion": "^4.0.521",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
